{
    // ============================================================
    // 编译任务：在 VS Code 里按 Ctrl+Shift+B 一键编译
    // 原理：调 cmake 配置 + 编译，产物输出到 build/ 目录
    // 修改提示：把 OpenCV_DIR 改成你自己 OpenCV 安装目录
    // ============================================================
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=C:/mingw64/bin/mingw32-make.exe",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DOpenCV_DIR=C:/dev/opencv/opencv/build_mingw/install/x64/mingw/lib"
            ],
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "-j"],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["cmake-configure"]
        }
    ]
}
